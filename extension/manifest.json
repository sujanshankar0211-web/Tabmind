{
    "manifest_version": 3,
    "name": "TabMind - AI Focus Assistant",
    "version": "1.1.0",
    "description": "Your AI-powered browser focus and research assistant.",
    "permissions": [
        "tabs",
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Open TabMind"
    }
}